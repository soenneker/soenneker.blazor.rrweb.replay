@using System.Text.Json
@using Microsoft.JSInterop
@using Soenneker.Atomics.ValueBools
@using Soenneker.Blazor.Rrweb.Replay.Abstract
@using Soenneker.Blazor.Rrweb.Replay.Configuration
@using Soenneker.Blazor.Utils.Ids
@implements IAsyncDisposable
@inject IRrwebReplayInterop ReplayInterop

<div @ref="_element" class="@Class" style="@Style" ></div>

@code {
    private readonly string _id = BlazorIdGenerator.New("rrwebreplay");
    private ElementReference _element;
    private JsonElement[]? _renderedEvents;
    private RrwebReplayOptions? _renderedOptions;
    private bool _created;
    private bool _renderedFitToContainer;
    private ValueAtomicBool _disposed;

    /// <summary>The complete recording. Replace the array to load a different session.</summary>
    [Parameter, EditorRequired]
    public JsonElement[] Events { get; set; } = [];

    /// <summary>Replay configuration. Replace the instance to rebuild the player.</summary>
    [Parameter]
    public RrwebReplayOptions Options { get; set; } = new();

    /// <summary>Whether to use pinned CDN assets instead of bundled assets.</summary>
    [Parameter]
    public bool UseCdn { get; set; } = true;

    /// <summary>Starts playback automatically when a recording is loaded.</summary>
    [Parameter]
    public bool AutoPlay { get; set; }

    /// <summary>Scales the recording down to fit its container while preserving the recorded page layout. Defaults to false.</summary>
    [Parameter]
    public bool FitToContainer { get; set; }

    /// <summary>CSS classes for the replay host.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Inline styles for the replay host.</summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>Invoked after a replayer has been created.</summary>
    [Parameter]
    public EventCallback OnReady { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Value)
            return;

        if (ReferenceEquals(Events, _renderedEvents) && ReferenceEquals(Options, _renderedOptions))
        {
            if (_created && FitToContainer != _renderedFitToContainer)
            {
                _renderedFitToContainer = FitToContainer;
                await ReplayInterop.SetFitToContainer(_id, _renderedFitToContainer);
            }
            return;
        }

        if (_created)
        {
            await ReplayInterop.Destroy(_id);
            _created = false;
        }

        JsonElement[] events = Events;
        RrwebReplayOptions options = Options;
        _renderedEvents = events;
        _renderedOptions = options;
        if (events.Length < 2 && !options.LiveMode)
            return;

        await ReplayInterop.Create(_id, _element, events, options, UseCdn);
        if (_disposed.Value)
        {
            await ReplayInterop.Destroy(_id);
            return;
        }

        _created = true;
        _renderedFitToContainer = FitToContainer;
        if (_renderedFitToContainer)
            await ReplayInterop.SetFitToContainer(_id, true);
        if (AutoPlay)
            await ReplayInterop.Play(_id);
        await OnReady.InvokeAsync();
    }

    /// <summary>Plays or resumes the current session, optionally seeking to a millisecond offset.</summary>
    public ValueTask Play(double? timeOffset = null) => ReplayInterop.Play(_id, timeOffset);

    /// <summary>Pauses the current session, optionally seeking to a millisecond offset.</summary>
    public ValueTask Pause(double? timeOffset = null) => ReplayInterop.Pause(_id, timeOffset);

    /// <summary>Changes the playback speed multiplier.</summary>
    public ValueTask SetSpeed(double speed) => ReplayInterop.SetSpeed(_id, speed);

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.CompareAndSet(false, true))
            return;
        
        if (!_created)
            return;
        try
        {
            await ReplayInterop.Destroy(_id);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

}
